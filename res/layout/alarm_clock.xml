<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:background="@color/alarm_bg" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:id="@id/unityview" android:layout_width="match_parent" android:layout_height="match_parent" />
    <View android:id="@id/alarm_boot_foreground" android:background="@drawable/alarm_bg_skin_0" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <FrameLayout android:id="@id/layout_root" android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:layout_gravity="bottom" android:id="@id/img_mask" android:layout_width="match_parent" android:layout_height="@dimen/alarm_digital_clock_mask_height" />
        <RelativeLayout android:id="@id/layout_alarm_drag" android:layout_width="match_parent" android:layout_height="match_parent">
            <View android:id="@id/view_header" android:layout_width="match_parent" android:layout_height="@dimen/alarm_digital_clock_margin_top" />
            <cn.nubia.redmagickyi.view.DigitalClock android:id="@id/layout_digital_clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="true" android:layout_below="@id/view_header">
                <TextView android:textSize="@dimen/alarm_digital_clock_time_text" android:textColor="@color/alarm_digital_clock_time_text" android:id="@id/tv_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:layout_centerInParent="true" />
                <TextView android:textSize="@dimen/alarm_digital_clock_ampm_text" android:textColor="@color/alarm_digital_clock_ampm_text" android:id="@id/tv_am_pm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:layout_alignBaseline="@id/tv_time" android:layout_alignBottom="@id/tv_time" android:layout_marginStart="@dimen/alarm_digital_clock_ampm_margin_left" android:layout_toEndOf="@id/tv_time" />
            </cn.nubia.redmagickyi.view.DigitalClock>
            <TextView android:textSize="@dimen/alarm_digital_clock_date_text" android:textColor="@color/alarm_digital_clock_date_text" android:gravity="center" android:id="@id/tv_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/alarm_digital_clock_date_margin_top" android:includeFontPadding="false" android:layout_below="@id/layout_digital_clock" />
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true">
                <LinearLayout android:gravity="center_horizontal" android:orientation="vertical" android:id="@id/layout_repeat" android:background="@mipmap/alarm_repeat_bg" android:paddingBottom="@dimen/alarm_digital_clock_layout_repeat_padding_bottom" android:visibility="invisible" android:layout_width="@dimen/alarm_digital_clock_layout_repeat_width" android:layout_height="@dimen/alarm_digital_clock_layout_repeat_height" android:layout_marginTop="@dimen/alarm_digital_clock_layout_repeat_margin_top" android:paddingStart="@dimen/alarm_digital_clock_layout_repeat_padding_left" android:paddingEnd="@dimen/alarm_digital_clock_layout_repeat_padding_right" android:layout_marginEnd="@dimen/alarm_digital_clock_layout_repeat_margin_right">
                    <TextView android:textSize="@dimen/alarm_digital_clock_layout_repeat_repeat_text" android:textColor="@color/alarm_digital_clock_layout_repeat_repeat_text" android:ellipsize="marquee" android:id="@id/tv_repeat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/alarm_digital_clock_layout_repeat_repeat_margin_top" android:singleLine="true" android:marqueeRepeatLimit="marquee_forever" />
                    <TextView android:textSize="@dimen/alarm_digital_clock_layout_repeat_alarm_text" android:textColor="@color/alarm_digital_clock_layout_repeat_alarm_text" android:ellipsize="end" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/alarm_digital_clock_layout_repeat_alarm_margin_top" android:text="@string/alarm_title" />
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:background="@mipmap/alarm_voice_bg" android:paddingTop="@dimen/alarm_digital_clock_layout_voice_padding_top" android:paddingBottom="@dimen/alarm_digital_clock_layout_voice_padding_bottom" android:layout_width="@dimen/alarm_digital_clock_layout_voice_width" android:layout_height="@dimen/alarm_digital_clock_layout_voice_height" android:layout_marginTop="@dimen/alarm_digital_clock_layout_voice_margin_top" android:layout_below="@id/layout_repeat" android:paddingStart="@dimen/alarm_digital_clock_layout_voice_padding_left" android:paddingEnd="@dimen/alarm_digital_clock_layout_voice_padding_right">
                    <TextView android:textSize="@dimen/alarm_digital_clock_layout_voice_voice_text" android:textColor="@color/alarm_digital_clock_layout_voice_voice_text" android:ellipsize="end" android:gravity="center_vertical" android:id="@id/tv_voice" android:layout_width="match_parent" android:layout_height="match_parent" android:maxLines="3" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:gravity="center|bottom" android:orientation="vertical" android:id="@id/hint_silde_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/alarm_digital_clock_layout_hint_slide_margin_bottom" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true">
                <ImageView android:layout_gravity="center_horizontal" android:id="@id/img_slide" android:layout_width="@dimen/alarm_digital_clock_layout_hint_slide_img_width" android:layout_height="@dimen/alarm_digital_clock_layout_hint_slide_img_height" android:src="@drawable/alarm_hint_slide_icon_group" />
                <cn.nubia.redmagickyi.view.MarqueeView.MarqueeTextView android:textSize="@dimen/alarm_digital_clock_layout_hint_text" android:textColor="@color/alarm_digital_clock_layout_hint_text" android:layout_gravity="center_horizontal" android:id="@id/tv_slide" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/alarm_digital_clock_layout_hint_text_marginTop" android:text="@string/alarm_upsilde_cancel" />
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>
</FrameLayout>
