<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/purple_1F4E3DA5" />
            <corners android:radius="@dimen/ns_3_dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:gravity="start" android:clipOrientation="horizontal">
            <scale android:scaleWidth="100%">
                <shape>
                    <corners android:radius="@dimen/ns_3_dp" />
                    <gradient android:startColor="@color/purple_FFC397FF" android:endColor="@color/purple_FF9896FF" android:angle="0.0" android:centerX="0.5" android:centerColor="@color/purple_FFC397FF" />
                </shape>
            </scale>
        </clip>
    </item>
</layer-list>
