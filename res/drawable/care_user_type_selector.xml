<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:state_pressed="false">
        <layer-list>
            <item android:height="@dimen/ns_32_dp" android:width="@dimen/ns_32_dp" android:drawable="@drawable/svg_checkbox_big_on" />
        </layer-list>
    </item>
    <item android:state_checked="false" android:state_pressed="false">
        <layer-list>
            <item android:height="@dimen/ns_32_dp" android:width="@dimen/ns_32_dp" android:drawable="@drawable/svg_checkbox_big_off" />
        </layer-list>
    </item>
</selector>
