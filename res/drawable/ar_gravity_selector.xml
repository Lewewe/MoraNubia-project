<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:state_pressed="false" android:drawable="@mipmap/ar_gravity_check" />
    <item android:state_checked="true" android:state_pressed="true">
        <layer-list>
            <item>
                <bitmap android:src="@mipmap/ar_gravity_check" />
            </item>
            <item>
                <bitmap android:src="@mipmap/ar_gravity_press" />
            </item>
        </layer-list>
    </item>
    <item android:state_checked="false" android:state_pressed="true">
        <layer-list>
            <item>
                <bitmap android:src="@mipmap/ar_gravity_uncheck" />
            </item>
            <item>
                <bitmap android:src="@mipmap/ar_gravity_press" />
            </item>
        </layer-list>
    </item>
    <item android:drawable="@mipmap/ar_gravity_uncheck" />
</selector>
