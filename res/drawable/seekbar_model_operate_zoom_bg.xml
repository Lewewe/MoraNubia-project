<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/model_operate_zoom_seekbar_bg" />
            <corners android:radius="@dimen/ns_3_dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <solid android:color="@color/model_operate_zoom_seekbar_progress_bg" />
                <corners android:radius="@dimen/ns_3_dp" />
            </shape>
        </clip>
    </item>
</layer-list>
